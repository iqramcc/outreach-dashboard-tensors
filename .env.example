# Local Docker Postgres (docker compose up -d db). Replace with any Postgres URL
# when you deploy - Neon, Supabase, or the VPS. Nothing else needs to change.
DATABASE_URL="postgresql://olympiad:olympiad@localhost:5432/olympiad?schema=public"

# Sign the login cookie. Generate one with:  openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# The first admin account, created by `npm run db:seed`.
ADMIN_NAME="Tensors Admin"
ADMIN_EMAIL="admin@tensors.org"
ADMIN_PASSWORD="changeme123"
